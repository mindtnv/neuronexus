{
  "name": "@neuronexus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "test": "NODE_ENV=test bun --env-file=../../.env test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-presigned-post": "^3.1063.0",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@neuronexus/auth": "workspace:*",
    "@neuronexus/db": "workspace:*",
    "@neuronexus/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "elysia": "^1.2.10",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sanitize-html": "^2.17.4",
    "ts-fsrs": "^5.3.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.7.3"
  }
}
