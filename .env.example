# ── Database (shared by packages/db + packages/auth + apps/api) ────────────
DATABASE_URL=postgres://neuronexus:neuronexus@localhost:5432/neuronexus

# Used by `bun test` — separate DB so tests can wipe tables between runs
# without touching dev data.
TEST_DATABASE_URL=postgres://neuronexus:neuronexus@localhost:5432/neuronexus_test

# ── BetterAuth ─────────────────────────────────────────────────────────────
# `openssl rand -base64 32` to generate
BETTER_AUTH_SECRET=change-me-in-production-please-32chars
BETTER_AUTH_URL=http://localhost:3000

# ── API ────────────────────────────────────────────────────────────────────
API_PORT=3000
WEB_ORIGIN=http://localhost:3001

# ── Web (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Email (optional) ───────────────────────────────────────────────────────
# If RESEND_API_KEY is unset, the api logs emails to stdout (dev-friendly).
# In prod set both to send real password-reset mail.
# RESEND_API_KEY=
# EMAIL_FROM="NeuroNexus <noreply@your-domain.com>"

# ── Media storage (M2) — local MinIO defaults; prod = Cloudflare R2 / AWS S3 ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=neuronexus-media
S3_ACCESS_KEY_ID=neuronexus
S3_SECRET_ACCESS_KEY=neuronexus-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/neuronexus-media
S3_FORCE_PATH_STYLE=true
MAX_MEDIA_BYTES=5242880
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/neuronexus-media

# ── AI / RAG (optional) ──────────────────────────────────────────────────────
# All vars below are OPTIONAL — leave unset to disable AI features. The app
# degrades, never crashes: with no keys the index queue no-ops, `/chat` shows a
# setup notice, and the rest of the app is unaffected. NEVER expose these as
# NEXT_PUBLIC_* — they are server-only secrets.
#
# There are TWO INDEPENDENT switches:
#   * embeddings/indexing → enabled when OPENAI_API_KEY is set AND
#     INDEXING_ENABLED != 'false'
#   * chat → enabled when CHAT_API_KEY is set
# so you can run chat (degraded retrieval) without indexing, or pause indexing
# without breaking thread reads.
#
# Embeddings (indexing side):
# OPENAI_API_KEY=
# EMBEDDING_BASE_URL is SEPARATE from CHAT_BASE_URL — the embedder may run on a
# different host/provider than the chat gateway. Defaults to OpenAI:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM must match the model (text-embedding-3-small = 1536). Changing
# it requires the reindex-on-model-change runbook (see CLAUDE.md → AI / RAG):
# regenerate the migration + reindex.
# NOTE: changing this alone disables embeddings until you regenerate the migration + reindex.
# EMBEDDING_DIM=1536
# Pause indexing without unsetting the key (default true):
# INDEXING_ENABLED=true
#
# Chat (OpenAI-compatible completion endpoint):
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# CHAT_API_KEY may equal OPENAI_API_KEY:
# CHAT_API_KEY=
#
# Retrieval tuning (chat grounding):
#  * RETRIEVE_K — max card chunks pulled per chat turn (default 12).
#  * RETRIEVE_MIN_SCORE — min cosine similarity (0..1) a chunk must clear to be
#    used (default 0.32). Below it the chunk is dropped, so an off-topic message
#    (e.g. a greeting) pulls 0 cards instead of k irrelevant ones. Lower → more
#    inclusive; raise → stricter. Calibrated for text-embedding-3-small.
# RETRIEVE_K=12
# RETRIEVE_MIN_SCORE=0.32
