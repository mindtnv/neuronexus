{
  "name": "@neuronexus/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:push": "drizzle-kit push --force",
    "db:push:test": "NODE_ENV=test drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:apply": "bun --env-file=../../.env run src/migrate.ts",
    "db:migrate:apply:test": "NODE_ENV=test bun --env-file=../../.env run src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun --env-file=../../.env run src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neuronexus/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3"
  }
}
